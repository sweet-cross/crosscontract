{#-
  Custom changelog template for python-semantic-release.

  Differences from PSR's default template:
    - Renders commit body paragraphs (everything after the subject) indented
      under each entry, so PR descriptions captured in the squash commit body
      become part of the changelog.
    - Friendlier section headings ("Features" instead of "feat", etc.).
    - Surfaces BREAKING CHANGE notes as a quoted block.

  Context provided by PSR:
    context.history.unreleased         dict[type, list[ParsedCommit]]
    context.history.released           OrderedDict[Version, Release]
      Release.tagged_date              datetime
      Release.elements                 dict[type, list[ParsedCommit]]
    ParsedCommit.descriptions          list[str]; [0] is the subject, [1:] are
                                        body paragraphs as parsed by the
                                        commit parser.
    ParsedCommit.breaking_descriptions list[str]; BREAKING CHANGE: footers.
    ParsedCommit.short_hash, hexsha    git identifiers.
  Filters:
    commit_hash_url                    hexsha -> link to commit on the host.
-#}
{%- set type_titles = {
    'feat':     'Features',
    'fix':      'Bug Fixes',
    'perf':     'Performance Improvements',
    'refactor': 'Code Refactoring',
    'docs':     'Documentation',
    'test':     'Tests',
    'build':    'Build System',
    'ci':       'Continuous Integration',
    'style':    'Styles',
    'chore':    'Chores',
    'revert':   'Reverts',
} -%}

{%- macro render_commit(commit) -%}
- **{{ commit.descriptions[0] | trim }}** ([`{{ commit.short_hash }}`]({{ commit.hexsha | commit_hash_url }}))
{%- for paragraph in commit.descriptions[1:] %}
{%- set text = paragraph | trim %}
{%- if text %}

{{ text | indent(2, first=true) }}
{%- endif %}
{%- endfor %}
{%- if commit.breaking_descriptions %}

  > **BREAKING CHANGE:** {{ commit.breaking_descriptions | join(' ') | trim }}
{%- endif %}
{%- endmacro -%}

{%- macro render_section(type_, commits) -%}
### {{ type_titles.get(type_, type_ | capitalize) }}

{% for commit in commits %}
{{ render_commit(commit) }}
{% endfor %}
{%- endmacro -%}

# CHANGELOG

{% if context.history.unreleased and context.history.unreleased | length > 0 -%}
## Unreleased

{% for type_, commits in context.history.unreleased.items() -%}
{{ render_section(type_, commits) }}

{% endfor -%}
{%- endif -%}

{% for version, release in context.history.released.items() -%}
## v{{ version }} ({{ release.tagged_date.strftime('%Y-%m-%d') }})

{% for type_, commits in release.elements.items() -%}
{{ render_section(type_, commits) }}

{% endfor %}
{% endfor -%}
